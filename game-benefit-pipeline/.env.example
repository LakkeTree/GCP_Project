# =============================================================================
# 이 파일을 복사해서 ".env" 라는 이름으로 저장한 뒤, 값을 채워 넣으세요.
#   Windows:  copy .env.example .env
#   Mac/Linux: cp .env.example .env
#
# ⚠️ .env 파일은 절대 GitHub에 올리지 마세요. (.gitignore에 이미 등록해 두었습니다)
# =============================================================================


# -----------------------------------------------------------------------------
# 1) Gemini AI 설정
# -----------------------------------------------------------------------------

# [방식 A] AI Studio API 키 사용 (초보자 추천, 지금은 이걸로 시작하세요)
#   발급: https://aistudio.google.com/apikey 접속 → "Create API key" 클릭
USE_VERTEXAI=false
GEMINI_API_KEY= 

# [방식 B] Vertex AI 사용 (GCP 크레딧/지원금을 소진하고 싶을 때)
#   위 USE_VERTEXAI 를 true 로 바꾸고, 아래 두 값을 채우세요.
#   그리고 터미널에서 `gcloud auth application-default login` 을 한 번 실행해야 합니다.
# VERTEX_LOCATION=us-central1

# 사용할 모델 이름. flash = 빠르고 저렴, pro = 느리지만 똑똑함.
# 크롤링 정제 작업은 flash로 충분합니다.
GEMINI_MODEL=gemini-3.6-flash

# AI에게 한 번에 넣을 수 있는 원문 최대 길이(글자 수). 너무 길면 비용이 급증합니다.
MAX_INPUT_CHARS=60000


# -----------------------------------------------------------------------------
# 2) GCP / BigQuery 설정
# -----------------------------------------------------------------------------

# GCP 콘솔 상단에서 확인할 수 있는 프로젝트 ID (프로젝트 "이름"이 아니라 "ID"입니다)
GCP_PROJECT_ID=

# BigQuery 데이터셋 이름.
# ⚠️ GCP 콘솔에서 확인한 실제 데이터셋 이름입니다 (benefit_info, platform_connection
#    테이블이 이미 이 데이터셋 안에 있습니다). 임의로 바꾸지 마세요.
BQ_DATASET=benefit

# 혜택 정보 테이블 이름
BQ_TABLE=benefit_info

# 플랫폼 호환성 테이블 이름
BQ_PLATFORM_TABLE=platform_connection

# 데이터셋 리전. 한국 서비스이므로 asia-northeast3(서울)을 권장합니다.
# ⚠️ 리전은 한 번 정하면 못 바꿉니다. 데이터셋을 지우고 다시 만들어야 합니다.
# ⚠️ 이미 데이터셋이 있다면 그 리전과 반드시 똑같이 적어야 합니다.
#    확인 방법: BigQuery 콘솔에서 데이터셋 클릭 > '세부정보' 탭 > 'Data location'
BQ_LOCATION=asia-northeast3

# 서비스 계정 키(JSON) 파일 경로.
# 로컬 PC에서 `gcloud auth application-default login` 을 했다면 비워 두어도 됩니다.
# 예) GOOGLE_APPLICATION_CREDENTIALS=C:/keys/my-service-account.json
GOOGLE_APPLICATION_CREDENTIALS=


# -----------------------------------------------------------------------------
# 3) 크롤러 공통 설정
# -----------------------------------------------------------------------------

# 서버에 부담을 주지 않기 위한 요청 간 대기 시간(초). 1.0 이상을 권장합니다.
CRAWL_DELAY_SEC=1.5

# HTTP 요청 타임아웃(초)
HTTP_TIMEOUT_SEC=20

# 로그 상세 수준: DEBUG / INFO / WARNING / ERROR
LOG_LEVEL=INFO

# true 로 두면 BigQuery에 실제로 쓰지 않고 화면에만 출력합니다 (연습용 안전장치).
DRY_RUN=false
